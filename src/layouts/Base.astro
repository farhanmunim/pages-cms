---
import '../styles/global.css';
import { CONTENT_KEYS, LABELS, getPermalinks, getPublished, getPublishedPages, getSite, href } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const site = await getSite();
const permalinks = await getPermalinks();
const { title, description = site.description, image = site.social_image } = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.tagline ? `${site.name} · ${site.tagline}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;

// Navigation: listings for collections that have a prefix and content, then pages.
const listings = [];
for (const key of CONTENT_KEYS) {
  if (permalinks[key] && (await getPublished(key)).length) {
    listings.push({ label: LABELS[key], url: href(permalinks[key]) });
  }
}
const pages = (await getPublishedPages()).filter((p) => p.id !== 'home');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {site.favicon && <link rel="icon" href={site.favicon} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? site.name} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {site.head_html && <Fragment set:html={site.head_html} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          {site.logo ? <img src={site.logo} alt={site.name} /> : site.name}
        </a>
        <nav class="nav" aria-label="Main">
          {listings.map((l) => <a href={l.url}>{l.label}</a>)}
          {pages.map((p) => <a href={href(permalinks.pages, p.id)}>{p.data.title}</a>)}
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {site.social.length > 0 && (
          <ul class="social">
            {site.social.map((s) => (
              <li>
                <a href={s.url} rel="me noopener">{s.handle || s.platform}</a>
              </li>
            ))}
          </ul>
        )}
        {site.copyright && <p>{site.copyright}</p>}
      </div>
    </footer>
    {site.footer_html && <Fragment set:html={site.footer_html} />}
  </body>
</html>
